//---{{!ClassName!}GameHub.cs}---
using System;
using AppScripts.{!ClassName!}.Abstractions;
using AppScripts.{!ClassName!}.Config;
using AppScripts.{!ClassName!}.Models;
using Cysharp.Threading.Tasks;
using Sirenix.OdinInspector;
using UnityEngine;
using Vortex.Sdk.MiniGamesSystem.MiniGames.Bus;
using Vortex.Sdk.MiniGamesSystem.MiniGames.Model;

namespace AppScripts.{!ClassName!}
{
    /// <summary>
    /// Хаб доступа к миниигре
    /// Содержит логику состояний миниигры, и принимает параметры для запуска
    /// Логика ограничений для запуска или иная логика не относящаяся к игровому процессу может быть здесь 
    ///
    /// Текущая реализация подразумевает строго один экземпляр миниигры на приложение
    /// Хаб запускает игру по запросу, после чего отслеживает изменение ее состояния по модели данных
    /// Хаб настраивается на один вариант контроллера через ассет конфигурации (direct DI)
    /// 
    /// </summary>
    public class {!ClassName!}GameHub : MiniGameHub<{!ClassName!}GameHub, {!ClassName!}GameData, {!ClassName!}GeneralConfig, I{!ClassName!}Controller>
    {
        /// <summary>
        /// Запуск игры асинхронно, для отслеживания завершения процесса снаружи
        /// </summary>
        /// <param name="playConfig">Стартовая конфигурация игры</param>
        protected override async UniTask PlayMiniGame(object playConfig)
        {
            if (playConfig is not {!ClassName!}PlayConfig config)
            {
                Debug.LogError($"[{!ClassName!}GameHub] {nameof(playConfig)} should be a {nameof({!ClassName!}PlayConfig)}");
                return;
            }

            //TODO определение и формирование прочих параметры игры

            Instance.Controller.Play();
            var old = MiniGameStates.Off;
            while (Data.State != MiniGameStates.Off)
            {
                if (old == Data.State)
                {
                    await UniTask.Yield();
                    continue;
                }

                old = Data.State;

                switch (Data.State)
                {
                    case MiniGameStates.Off:
                        return;
                    case MiniGameStates.Play:
                        CallOnStart();
                        break;
                    case MiniGameStates.Win:
                        CallOnWin();
                        break;
                    case MiniGameStates.Fail:
                        CallOnFail();
                        break;
                    case MiniGameStates.Paused:
                        break;
                    case MiniGameStates.Loading:
                        break;
                    default:
                        throw new ArgumentOutOfRangeException();
                }

                await UniTask.Yield();
            }
        }

        #region Init/Destroy

        protected override void Awake()
        {
            //Валидация данных
            //TODO проверки параметров

            base.Awake();
        }

        protected override void OnDestroy()
        {
            //TODO Отписки!!!
            base.OnDestroy();
        }

        #endregion

        #region Debug

        /// <summary>
        /// Тестовый запуск с дебаг-набором параметров
        /// </summary>
        internal static void DebugPlay()
        {
            var playConfig = new {!ClassName!}PlayConfig
            {
                //TODO
            };
            Play(playConfig).Forget(Debug.LogException);
        }


#if UNITY_EDITOR

        [Button]
        private void TestRun() => Play().Forget(Debug.LogException);

        [Button, HideIf("ShowButtons")]
        private void SetWinState()
        {
            if (Data.State != MiniGameStates.Off)
                Data.DebugSetState(MiniGameStates.Win);
        }

        [Button, HideIf("ShowButtons")]
        private void SetFailState()
        {
            if (Data.State != MiniGameStates.Off)
                Data.DebugSetState(MiniGameStates.Fail);
        }

        private bool ShowButtons()
        {
            if (Data == null) return true;
            return Data.State == MiniGameStates.Off;
        }
#endif

        #endregion
    }
}

//---{Config/{!ClassName!}GeneralConfig.cs}---
using System;
using AppScripts.{!ClassName!}.Abstractions;
using Sirenix.OdinInspector;
using UnityEngine;
using Vortex.Core.Extensions.LogicExtensions;
using Vortex.Sdk.MiniGamesSystem.MiniGames.Abstractions;

#if UNITY_EDITOR
using Vortex.Unity.Extensions.Editor.Misc;
#endif

namespace AppScripts.{!ClassName!}.Config
{
    /// <summary>
    /// Основная конфигурация миниигры
    /// </summary>
    [CreateAssetMenu(fileName = "{!ClassName!}GeneralConfig", menuName = "Minigames/{!ClassName!} Game Config")]
    public class {!ClassName!}GeneralConfig : ScriptableObject, IMiniGameConfig
    {
        /// <summary>
        /// Контроллер игры
        /// </summary>
        [InfoBox(
            "Контроллер игры. Определяет логику и правила обработки данных.\nСкорее всего он будет только один, но возможность подмены есть")]
        [SerializeField, GUIColor("GuiColor"), ValueDropdown("GetControllers")]
        private string gameController;

        /// <summary>
        /// Контроллер игры
        /// </summary>
        public string GameController => gameController;

        /// <summary>
        /// Представление игры
        /// </summary>
        [InfoBox(
            "Визуальный вариант игры. Представление данных.\nСюда можно воткнуть MockUp")]
        [SerializeField]
        private GameObject view;

        /// <summary>
        /// Представление игры
        /// </summary>
        /// <returns></returns>
        public GameObject GetView() => view;

        /// <summary>
        /// Имя типа контролера игры
        /// </summary>
        /// <returns></returns>
        public string GetController() => gameController;

#if UNITY_EDITOR
        private bool _hasError = false;

        private Color GuiColor() => _hasError ? Color.red : Color.white;

        private ValueDropdownList<string> GetControllers() => DropDawnHandler.GetTypesNameList<I{!ClassName!}Controller>();

        private void OnValidate()
        {
            _hasError = false;
            if (gameController.IsNullOrWhitespace())
            {
                _hasError = true;
                return;
            }

            var type = Type.GetType(gameController);
            if (type == null)
            {
                _hasError = true;
                return;
            }

            if (!typeof(I{!ClassName!}Controller).IsAssignableFrom(type))
                _hasError = true;
        }

#endif
    }
}

//---{Controllers/{!ClassName!}Controller.cs}---
using AppScripts.{!ClassName!}.Abstractions;
using AppScripts.{!ClassName!}.Models;
using Vortex.Sdk.MiniGamesSystem.MiniGames.Controllers;
using Vortex.Sdk.MiniGamesSystem.MiniGames.Model;

namespace AppScripts.{!ClassName!}.Controllers
{
    /// <summary>
    /// Основной контроллер миниигры
    /// TODO Здесь нужно прописать основные действия с моделью данных.
    /// TODO Инициализация, проверка на победу и поражение, запрос на изменение данных. 
    /// </summary>
    public class {!ClassName!}Controller : MiniGameController<{!ClassName!}Controller, {!ClassName!}GameData>, I{!ClassName!}Controller
    {
        /// <summary>
        /// Инициализация контроллера.
        /// Создается экземпляр модели данных миниигры.
        /// Производится подписка на события приложения.
        /// </summary>
        public override void Init()
        {
            base.Init();
        }

        /// <summary>
        /// Деинициализация контроллера
        /// </summary>
        public override void DeInit()
        {
            Data.OnGameStateChanged -= OnStateLogic;
            base.DeInit();
        }

        public override void Play()
        {
            Data.OnGameStateChanged -= OnStateLogic;
            Data.OnGameStateChanged += OnStateLogic;
            SetState(MiniGameStates.Play);
        }

        //TODO public void SetGameData(???)

        /// <summary>
        /// Проверка после истечения таймера и перевод игры в одно из двух положений
        /// </summary>
        private void OnTimerRunOut()
        {
            /*
            var result = TODO логика проверки;
            SetState(result ? MiniGameStates.Win : MiniGameStates.Fail);
            */
        }

        /// <summary>
        /// Вспомогательный обработчик изменения состояния.
        /// В идеале служит только для управления таймером при обработке паузы,
        /// так как остальные состояния должны проходить через контроллер и обрабатываться
        /// на момент их активации  
        /// </summary>
        /// <param name="state"></param>
        private void OnStateLogic(MiniGameStates state)
        {
            switch (state)
            {
                case MiniGameStates.Play:
                    break;
                case MiniGameStates.Off:
                    Data.OnGameStateChanged -= OnStateLogic;
                    break;
                default:
                    break;
            }
        }
    }
}

