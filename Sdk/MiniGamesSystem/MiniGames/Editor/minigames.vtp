//---{Editor/{!ClassName!}GameMenuController.cs}---
#if UNITY_EDITOR
using AppScripts.{!ClassName!}.Config;
using UnityEditor;
using UnityEngine;
using Vortex.Unity.EditorTools;

namespace AppScripts.{!ClassName!}.Editor
{
    /// <summary>
    /// Вспомогательный класс-tools для упрощения поиска ассета с настройками миниигры
    /// </summary>
    public static class {!ClassName!}GameMenuController
    {
        [MenuItem("Assets/Find Configs/{!ClassName!} Game")]
        private static void Find{!ClassName!}GameConfig()
        {
            var resource = AssetFinder.FindAsset<{!ClassName!}GeneralConfig>();
            FindAsset(resource);
        }

        private static void FindAsset(ScriptableObject res)
        {
            Selection.activeObject = res;
        }
    }
}
#endif

//---{Handler/{!ClassName!}GameStateCondition.cs}---
using System;
using Vortex.Core.UIProviderSystem.Model;
using Vortex.Sdk.MiniGamesSystem.MiniGames.Bus;
using Vortex.Sdk.MiniGamesSystem.MiniGames.Model;
using Vortex.Unity.UIProviderSystem.Model;

namespace AppScripts.{!ClassName!}.Handler
{
    [Serializable]
    public class {!ClassName!}GameStateCondition : UnityUserInterfaceCondition
    {
        protected override void Run()
        {
            MiniGamesController.OnStartMiniGame += RunCallback;
            MiniGamesController.OnStopMiniGame += RunCallback;
            RunCallback();
        }

        public override void DeInit()
        {
            MiniGamesController.OnStartMiniGame -= RunCallback;
            MiniGamesController.OnStopMiniGame -= RunCallback;
        }

        public override ConditionAnswer Check()
        {
            if ({!ClassName!}GameHub.Data == null)
                return ConditionAnswer.Close;
            return {!ClassName!}GameHub.Data.State != MiniGameStates.Off
                ? ConditionAnswer.Open
                : ConditionAnswer.Close;
        }
    }
}

//---{Handler/{!ClassName!}StartHandler.cs}---
using AppScripts.{!ClassName!};
using UnityEngine;
using UnityEngine.UI;

namespace AppScripts.{!ClassName!}.Handler
{
    /// <summary>
    /// Хэндлер запуска миниигры в дебаг-режиме.
    /// Необходимость использования этого хэндлера определяется архитектурой
    /// взаимодействий элементов сцены
    /// </summary>
    public class {!ClassName!}StartHandler : MonoBehaviour
    {
        /// <summary>
        /// Кнопка, к которой привязывается хэндлер
        /// (опционально) 
        /// </summary>
        [SerializeField] private Button button;

        [SerializeField, Range(0, 2)] private byte hardness;

        private void OnEnable()
        {
            button?.onClick.AddListener(Play);
        }

        private void OnDisable()
        {
            button?.onClick.RemoveListener(Play);
        }

        /// <summary>
        /// Метод тестового запуска
        /// (то есть запуска с неполными данными)
        /// </summary>
        public void Play() => {!ClassName!}GameHub.DebugPlay();
    }
}

